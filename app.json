{
  "expo": {
    "name": "Pocket Agent",
    "slug": "pocket-agent",
    "scheme": "pocketagent",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.pocketagent.app",
      "supportsTablet": true
    },
    "android": {
      "package": "dev.pocketagent.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "enableOpenCLAndHexagon": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "largeHeap": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}