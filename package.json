{
  "name": "pocket-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first personal chat assistant for React Native: on-device LLM (llama.rn), MCP tool connections, PDF reports.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON eval/run.ts",
    "eval:pdf": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON eval/run.ts --pdf",
    "live": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON eval/live.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@op-engineering/op-sqlite": "^19.0.3",
    "expo": "~58.0.23",
    "expo-auth-session": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "llama.rn": "^0.13.0-rc.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "op-sqlite": {
    "fts5": true
  }
}
