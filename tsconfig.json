{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["app", "src", "eval", "tests", "*.ts", "*.mts"]
}
